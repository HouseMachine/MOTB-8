{
  "name": "motb-8",
  "version": "0.1.0",
  "description": "Open-source Machine Open Tag & Beacon protocol for persistent, discoverable machine presence.",
  "main": "./dist/index.js",
  "scripts": {
    "test": "npm run build && node --test tests/*.test.mjs",
    "build": "node scripts/generate-browser-validators.mjs && tsc && node scripts/copy-browser-validators.mjs && npm run build:browser",
    "lint": "eslint tests/**/*.mjs",
    "build:browser": "esbuild src/browser/index.ts --bundle --platform=browser --format=esm --target=es2022 --outfile=dist/browser/motb8-browser.bundle.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HouseMachine/MOTB-8.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/HouseMachine/MOTB-8/issues"
  },
  "homepage": "https://www.motb8.com",
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "canonicalize": "^5.1.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/motb8-browser.bundle.js"
    }
  },
  "files": [
    "dist/",
    "schemas/",
    "docs/",
    "README.md",
    "LICENSE",
    "vocabularies/"
  ],
  "bin": {
    "motb8": "./dist/cli/index.js"
  }
}
